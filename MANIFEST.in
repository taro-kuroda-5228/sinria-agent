graft skills
graft optional-skills

# Public release artifacts contain runtime code and reusable skills, not the
# repository's test harness or organization-specific private overlays.
prune tests

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude test_*.py
global-exclude *_test.py
global-exclude conftest.py
global-exclude pytest.ini
global-exclude .env
global-exclude .env.*
global-exclude *.pem
global-exclude *.key
